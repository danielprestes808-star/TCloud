{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "TCloud",
    "version":  "13.0.15",
    "identifier":  "com.tcloud.desktop",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "TCloud",
                                    "width":  1200,
                                    "height":  800,
                                    "minWidth":  1000,
                                    "minHeight":  700,
                                    "dragDropEnabled":  true,
                                    "devtools":  true
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; connect-src \u0027self\u0027 https: http://localhost:* https://asset.localhost http://asset.localhost; media-src \u0027self\u0027 blob: http://localhost:*; img-src \u0027self\u0027 data: blob: asset: https: https://asset.localhost http://asset.localhost; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; script-src \u0027self\u0027 \u0027unsafe-inline\u0027 \u0027unsafe-eval\u0027 blob: https:; frame-src \u0027self\u0027 blob: https: http://localhost:* http://127.0.0.1:*; worker-src \u0027self\u0027 blob:;",
                                 "assetProtocol":  {
                                                       "enable":  true,
                                                       "scope":  [
                                                                     "$APPCACHE/previews/**",
                                                                     "$APPDATA/thumbnails/**"
                                                                 ]
                                                   },
                                 "capabilities":  [
                                                      "default"
                                                  ]
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "createUpdaterArtifacts":  false,
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "macOS":  {
                                 "entitlements":  "entitlements.plist"
                             }
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "",
                                    "endpoints":  [

                                                  ]
                                }
                }
}