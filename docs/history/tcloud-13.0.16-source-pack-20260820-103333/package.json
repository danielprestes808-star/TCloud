{
  "name": "tcloud",
  "private": true,
  "version": "13.0.15",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "desktop:verify": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/verify-desktop-only.ps1",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-cli.cjs",
    "i18n:validate": "node scripts/i18n/validate-locales.cjs",
    "i18n:scan": "node scripts/i18n/scan-ui-literals.cjs",
    "i18n:types": "node scripts/i18n/generate-key-types.cjs",
    "i18n:pseudo": "node scripts/i18n/generate-pseudo-locales.cjs",
    "i18n:check": "npm run i18n:types && npm run i18n:validate && npm run i18n:scan",
    "tauri:shell": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/run-tauri-shell.ps1",
    "shell:unregister": "winapp unregister --manifest .\\Package.appxmanifest --force",
    "pack:msix": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/build-msix.ps1",
    "stability:check": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/stability-smoke.ps1",
    "stability:soak": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/stability-soak.ps1",
    "stability:stress": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/stability-stress.ps1",
    "stability:upgrade": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/stability-upgrade.ps1",
    "release:windows": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/release-windows-stable.ps1",
    "release:windows:resume": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/release-windows-stable.ps1 -ReuseExistingBundle",
    "rc:check": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/release-candidate.ps1",
    "release:preflight": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/release-preflight.ps1",
    "release:windows:public": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/release-windows-stable.ps1 -RequireSignature -EnableUpdater",
    "release:installed-check": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/verify-installed-windows.ps1",
    "updater:toolchain": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-updater-toolchain.ps1",
    "updater:keygen": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/setup-updater-signing.ps1",
    "updater:preflight": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/updater-preflight.ps1",
    "release:windows:update": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/release-windows-stable.ps1 -EnableUpdater"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tanstack/react-query": "^5.90.17",
    "@tanstack/react-virtual": "^3.13.18",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "framer-motion": "^12.26.2",
    "hls.js": "^1.6.16",
    "i18next": "^26.3.1",
    "lucide-react": "^0.562.0",
    "mp4box": "^2.3.0",
    "pdfjs-dist": "^5.6.205",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.8",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
